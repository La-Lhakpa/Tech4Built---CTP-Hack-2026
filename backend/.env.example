# Get an API key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_api_key_here

# Optional overrides
GEMINI_MODEL=gemini-3.6-flash
PORT=8080

# Comma-separated list of frontend origins allowed to call this backend
CORS_ORIGIN=http://localhost:3000

# Set to "true" to serve a locally computed plan instead of a 500 when Gemini
# is unavailable. Off by default so /api/plan honors the 500 error contract.
PLAN_FALLBACK=false
